#!/bin/bash
#SBATCH --partition=debug
#SBATCH --cpus-per-task=2
#SBATCH --mem=24G
#SBATCH --time=02:00:00
#SBATCH --job-name=assemble-v9a
#SBATCH --output=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/logs/assemble_v9a-%j.log
set -euo pipefail
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
cd /data1/SRL_V2D
/data1/SRL_V2D/challenge_reconstruction/dexagent_final_recon_20261017/.venv/bin/python -B -u /data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/package_code/assemble_twenty_swap.py --original-package /data1/SRL_V2D/challenge_submissions/track3_v8_20261021/all_20_episodes  --component 14=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep14_v9/staging/common_components/episode_000014 --portable 14=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep14_v9/staging/portable_archives/episode_000014_portable.tar.gz --video 14=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/videos_v9/episode_000014 --component 16=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep16_v9/staging/common_components/episode_000016 --portable 16=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep16_v9/staging/portable_archives/episode_000016_portable.tar.gz --video 16=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/videos_v9/episode_000016 --component 28=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep28_v9/staging_up/common_components/episode_000028 --portable 28=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep28_v9/staging_up/portable_archives/episode_000028_portable.tar.gz --video 28=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/videos_v9/episode_000028 --component 30=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep30_v9/staging/common_components/episode_000030 --portable 30=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep30_v9/staging/portable_archives/episode_000030_portable.tar.gz --video 30=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/videos_v9/episode_000030 --reason "v9: scan rack re-placed by a flat refit to the video-reconstructed rack in episodes 14/16/28 with the robot re-planned (cup upright, spoon in the holder, pot set down level); episode 30 release re-planned so the brush stays standing in its rack slot" --output /data1/SRL_V2D/challenge_submissions/track3_v9_20261021/all_20_episodes_no_ep10 --archive
