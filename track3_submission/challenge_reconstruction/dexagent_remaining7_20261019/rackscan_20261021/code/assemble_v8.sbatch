#!/bin/bash
#SBATCH --partition=debug
#SBATCH --cpus-per-task=2
#SBATCH --mem=24G
#SBATCH --time=02:00:00
#SBATCH --job-name=assemble-v8
#SBATCH --output=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/logs/assemble_v8-%j.log
set -euo pipefail
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
cd /data1/SRL_V2D
/data1/SRL_V2D/challenge_reconstruction/dexagent_final_recon_20261017/.venv/bin/python -u /data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/package_code/assemble_twenty_swap.py --original-package /data1/SRL_V2D/challenge_submissions/track3_rackscan_v7_20261021/all_20_episodes  --component 1=/data1/SRL_V2D/challenge_reconstruction/dexagent_final_recon_20261017/refinement_20261021_ep1/staging/common_components/episode_000001 --portable 1=/data1/SRL_V2D/challenge_reconstruction/dexagent_final_recon_20261017/refinement_20261021_ep1/staging/portable_archives/episode_000001_portable.tar.gz --video 1=/data1/SRL_V2D/challenge_reconstruction/dexagent_final_recon_20261017/refinement_20261021_ep1/videos/episode_000001  --component 14=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/staging_v8_ep14/common_components/episode_000014 --portable 14=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/staging_v8_ep14/portable_archives/episode_000014_portable.tar.gz --video 14=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/videos_v8/episode_000014  --component 30=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep30_v8/staging/common_components/episode_000030 --portable 30=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/ep30_v8/staging/portable_archives/episode_000030_portable.tar.gz --video 30=/data1/SRL_V2D/challenge_reconstruction/dexagent_remaining7_20261019/rackscan_20261021/videos_v8/episode_000030  --reason "v8: episode 1 single power grasp (no repeated handle contacts); episode 14 cup set down upright over a rack post; episode 30 sweeper track half-turn tracker flip corrected and re-planned (corrected-track lineage in evidence)"  --output /data1/SRL_V2D/challenge_submissions/track3_v8_20261021/all_20_episodes_pre15 --archive
